@page "/type"
@implements IDisposable
@implements IAsyncDisposable

@* dir drives the whole page: the browser mirrors the flex rows for a right-to-left script, so
   scan index 0 is the rightmost key, and the sentence reads in the right direction. *@
<div class="bt-root"
     style="--bt-hl-color: @DepthColor"
     dir="@TextDirection"
     tabindex="0"
     @ref=Root
     @onpointerdown=OnIndicate
     @onkeydown=OnKeyDown
     @onkeydown:preventDefault="true">

    <button class="bt-settings-button"
            title="Settings"
            @onpointerdown:stopPropagation="true"
            @onpointerdown=GoToSettings>⚙</button>

    <!-- Current sentence -->
    <div class="bt-sentence @(Controller.Sentence.ShouldClearOnNextInput ? "bt-pending" : "")">
        @if (string.IsNullOrEmpty(SentenceText))
        {
            <span class="bt-sentence-placeholder">…</span>
        }
        else
        {
            @* Committed words read as a normal sentence; the word being edited sits in a box
               (empty after a space, showing a new word has been started). *@
            @CommittedText<span class="bt-current-word">@CurrentWord</span>
        }
    </div>

    <!-- Word suggestions -->
    <div class="bt-section bt-words @SectionClass(Section.WordSelector) @WordsContextClass">
        @if (Words.Count == 0)
        {
            <span class="bt-words-empty">no suggestions</span>
        }
        else
        {
            @* data-word-index is how the scroll-into-view script finds the highlighted word:
               the index is stable across renders, where an ElementReference is not. *@
            @for (int i = 0; i < Words.Count; i++)
            {
                <span class="bt-word @WordClass(i)" data-word-index="@i">@Words[i]</span>
            }
        }
    </div>

    <!-- Keyboard -->
    <div class="bt-section bt-keyboard @SectionClass(Section.Keyboard) @KeyboardContextClass">
        @for (int r = 0; r < Rows.Count; r++)
        {
            int rowIndex = r;
            <div class="bt-row @RowClass(rowIndex)">
                @for (int c = 0; c < Rows[rowIndex].Count; c++)
                {
                    int colIndex = c;
                    var key = Rows[rowIndex][colIndex];
                    <span class="bt-key @(key.Kind == KeyboardKeyKind.Space ? "bt-key-wide" : "") @KeyClass(rowIndex, colIndex)">
                        @key.Label
                    </span>
                }
            </div>
        }
    </div>

    <!-- Speak -->
    <div class="bt-section bt-speak @SectionClass(Section.Speak)">
        SPEAK
    </div>

    @* The letter decorators on offer. Inside the root div, not beside it: the whole root is the
       indicate surface, so a tap that lands on the popup still has to reach it. *@
    @if (Controller.IsChoosingDecorator)
    {
        <div class="bt-modal-backdrop">
            <div class="bt-modal bt-decorators">
                @for (int d = 0; d < Decorators.Count; d++)
                {
                    int decoratorIndex = d;
                    @* The dotted circle gives the combining mark a letter to sit on, so it has a
                       shape of its own to be recognised by. *@
                    <span class="bt-key bt-decorator @DecoratorClass(decoratorIndex)">
                        @(KeyboardKey.DottedCircle + Decorators[decoratorIndex])
                    </span>
                }
            </div>
        </div>
    }

    @* When the camera indicator is enabled+trained, it triggers its own indicator, which the
       controller subscribes to just like the pointer and keyboard. *@
    <CameraIndicator />
</div>


