@page "/"
@page "/settings"
@using System.Globalization
@using BlinkTalk.Application
@using BlinkTalk.Application.Abstractions
@using BlinkTalk.Application.Text
@using BlinkTalk.Services

@* Mirrored for a right-to-left language, so labels sit with the controls they belong to. *@
<div class="bt-settings" dir="@TextDirection">
    <h1>@Localization.Settings_Title</h1>

    <div class="bt-setting-row bt-setting-columns">
        <div class="bt-setting-field">
            <label for="language">@Localization.Settings_Language</label>
            @* @bind rather than value/@onchange: it is what makes Blazor select the matching <option> on
               first render, so the dropdown opens showing the language the app is actually running in. *@
            <select id="language" @bind=SelectedLanguage @bind:after=OnLanguageChangedAsync>
                @foreach (CultureInfo language in Languages)
                {
                    <option value=@language.Name>@language.NativeName</option>
                }
            </select>
        </div>

        <div class="bt-setting-field">
            <label for="keyboardLayout">@Localization.Settings_KeyboardLayout</label>
            <select id="keyboardLayout" @bind=SelectedKeyboardLayout>
                @foreach (KeyboardLayoutStyle style in KeyboardLayoutStyles)
                {
                    <option value=@style>@LayoutLabel(style)</option>
                }
            </select>
        </div>

        @* Only worth a dropdown where the engine offers a choice; a device with one voice (or none it
           can name — the norm on stock Android) gets the test button alone, since "System default"
           would be the only option. *@
        <div class="bt-setting-field">
            <label for="voice">@Localization.Settings_Voice</label>
            <div class="bt-setting-inline">
                @if (Voices.Count > 1)
                {
                    <select id="voice" @bind=SelectedVoiceId @bind:after=OnVoiceChangedAsync>
                        <option value="">@Localization.Settings_Voice_SystemDefault</option>
                        @foreach (SpeechVoiceOption voice in Voices)
                        {
                            <option value=@voice.Id>@voice.DisplayName</option>
                        }
                    </select>
                }
                @* Icon rather than a word: it sits beside the dropdown, where a translated label would
                   push the two onto separate lines in the longer languages. The name it would have
                   shown is the accessible name instead, and the tooltip. *@
                <button class="bt-settings-secondary bt-settings-icon"
                        type="button"
                        title=@Localization.Settings_Voice_Test
                        aria-label=@Localization.Settings_Voice_Test
                        @onclick=TestVoiceAsync>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        @* Speaker cone, then two arcs for the sound coming off it. currentColor so it
                           follows the button's text colour in either theme. *@
                        <path d="M4 9h3l5-4v14l-5-4H4z" fill="currentColor" />
                        <path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12"
                              fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <div class="bt-setting-row">
        <h2>@Localization.Settings_ScanSpeed</h2>
        @Localization.Settings_ScanSpeed_Description
        <input id="scanSpeed"
               type="range"
               min="0.3"
               max="4.0"
               step="0.1"
               value=@ScanSpeed.ToString(CultureInfo.InvariantCulture)
               @oninput=OnScanSpeedChanged />
        @* See the note on the dwell label in Camera.razor: the culture has to be passed explicitly,
           because the ambient one reverts to the startup language between events. *@
        <label for="scanSpeed">@string.Format(AppLanguage.Current, Localization.Settings_ScanSpeed_ScanSpeedX0SecondsPerStepFormat, ScanSpeed)</label>
    </div>

    <div class="bt-setting-row">
        <h2>@Localization.Settings_IndicatorMethod</h2>
        <label class="bt-cam-check">
            <input type="checkbox" checked=@true disabled />
            @Localization.Settings_AssistantTapsScreenOrClicksMouse
        </label>
        <label class="bt-cam-check">
            <input type="checkbox" checked=@true disabled />
            @Localization.Settings_AssistantPressesSpaceBarOnKeyboard
        </label>
        <label class="bt-cam-check">
            <input type="checkbox" checked=@Camera.IsEnabled disabled />
            @Localization.Settings_UseCameraToDetectEyeGesture
            <button class="bt-settings-secondary" @onclick=GoToCamera>@Localization.Settings_SetUpCamera</button>
        </label>
    </div>

    <button class="bt-settings-back" @onclick=GoBackAsync>@Localization.Shared_Done</button>
</div>

@if (IsDownloading)
{
    <div class="bt-modal-backdrop" dir="@TextDirection">
        <div class="bt-modal">
            <h2>@string.Format(Localization.Settings_DownloadingLanguagePackX0Format, AppLanguage.Name)</h2>
            @if (DownloadError is not null)
            {
                <p class="bt-modal-error">@DownloadError</p>
                <button class="bt-settings-secondary" @onclick=CloseDownloadModal>@Localization.Shared_Done</button>
            }
            else
            {
                @* No value attribute while the total size is unknown → the bar is indeterminate. *@
                @if (DownloadProgress is double progress)
                {
                    <progress max="1" value=@progress.ToString("0.###", CultureInfo.InvariantCulture)></progress>
                }
                else
                {
                    <progress></progress>
                }
                <button class="bt-settings-secondary" @onclick=CancelDownload>@Localization.Shared_Cancel</button>
            }
        </div>
    </div>
}


