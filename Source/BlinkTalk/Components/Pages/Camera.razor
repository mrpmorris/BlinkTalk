@page "/camera"
@implements IAsyncDisposable

<div class="bt-settings bt-cam-page @(Flash ? "bt-cam-flash" : "")">
    <div class="bt-cam-top">
        <div class="bt-cam-feed">
            <video @ref=Video autoplay playsinline muted></video>
        </div>

        <div class="bt-cam-actions">
            <button class="bt-settings-back" @onclick=TrainAsync disabled=@Busy>@(Busy ? Localization.Camera_Training : Localization.Camera_Train)</button>
            @if (Error is not null)
            {
                <p class="bt-cam-error">@Error</p>
            }
            <p class="bt-cam-status">@Status</p>
        </div>
    </div>

    <div class="bt-cam-scroll">
        @if (SignalDescription is not null)
        {
            <div class="bt-setting-row">
                <h2>@Localization.Camera_EyeGesture</h2>
                <label>@Localization.Camera_LearntGesture: <strong>@SignalDescription</strong></label>
                <div class="bt-meter"><div class="bt-meter-fill" style="width:@($"{(int)(HoldFraction * 100)}%")"></div></div>
                <label for="holdTime">@string.Format(Localization.Camera_HoldTimeX0SecondsFormat, DwellSeconds)</label>
                @Localization.Camera_TestingInstructions
                <input id="holdTime"
                       type="range"
                       min="0.1"
                       max="2.0"
                       step="0.1"
                       value=@DwellSeconds
                       @oninput=OnDwellChanged />
            </div>
        }

        <label class="bt-cam-check">
            <input type="checkbox"
                   checked=@Config.IsEnabled
                   disabled=@(!Config.IsTrained || Busy)
                   @onchange=OnUseCameraChanged />
            @Localization.Camera_UseCamera @(Config.IsTrained ? "" : $"({Localization.Camera_TrainFirst})")
        </label>

        <button class="bt-settings-back" @onclick=GoBack>@Localization.Shared_Done</button>
    </div>
</div>


