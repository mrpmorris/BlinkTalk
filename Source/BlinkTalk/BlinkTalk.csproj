<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- CI: pass -p:PublishTargetFramework=<tfm> to build ONLY that TFM. This lets the
             release pipeline publish platform-specific artifacts on runners that have only
             the matching MAUI workload installed. A custom property name is used deliberately:
             unlike the reserved TargetFrameworks, it does NOT flow into referenced projects,
             so BlinkTalk.Application keeps its own target framework. WindowsPublish remains
             for the existing Windows packaging pipeline. -->
        <TargetFrameworks Condition="'$(PublishTargetFramework)' != ''">$(PublishTargetFramework)</TargetFrameworks>
        <TargetFrameworks Condition="'$(PublishTargetFramework)' == '' and '$(WindowsPublish)' == 'true'">net10.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="'$(PublishTargetFramework)' == '' and '$(WindowsPublish)' != 'true'">net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="'$(PublishTargetFramework)' == '' and '$(WindowsPublish)' != 'true' and !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="'$(PublishTargetFramework)' == '' and '$(WindowsPublish)' != 'true' and $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>BlinkTalk</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>BlinkTalk</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.airsoftwarelimited.blinktalk.app</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!-- MobileILStrip hangs in the hosted iOS Release publish after ILLink succeeds.
         This skips only post-AOT method-body stripping; normal ILLink trimming remains enabled. -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
        <EnableAssemblyILStripping>false</EnableAssemblyILStripping>
    </PropertyGroup>

    <!-- The ILLink managed-code trimmer itself (the "Optimizing assemblies for size. This
         process might take a while." message logged by the SDK's ILLinkRunning resource, before
         the _RunILLink target invokes the ILLink task) can hang for 1+ hours on the hosted iOS/Mac
         Catalyst Release runners for this app, independently of the EnableAssemblyILStripping
         setting above (which only covers the later, AOT-only, MobileILStrip step). PublishTrimmed
         is the property that gates whether _RunILLink runs at all, so disabling it here skips
         managed trimming entirely - but only for iOS/Mac Catalyst Release publishes; trimming
         stays on (and unaffected) for every other target framework and configuration. -->
    <PropertyGroup Condition="('$(TargetFramework)' == 'net10.0-ios' or '$(TargetFramework)' == 'net10.0-maccatalyst') and '$(Configuration)' == 'Release'">
        <PublishTrimmed>false</PublishTrimmed>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#F1F1F1" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.jpg" Color="#F1F1F1" BaseSize="86,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" Exclude="Resources\Raw\*.db" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.80" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
        <!-- Native SQLite engine for all target platforms (Microsoft.Data.Sqlite in Core uses it). -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\BlinkTalk.Application\BlinkTalk.Application.csproj" />
      <ProjectReference Include="..\BlinkTalk.Resources\BlinkTalk.Resources.csproj" />
    </ItemGroup>

</Project>
